{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-mgmt",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "student_mgmt_db",
      "database_id": "local-db-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "student-mgmt-files"
    }
  ]
}
